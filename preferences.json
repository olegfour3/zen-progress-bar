[
  {
    "type": "separator",
    "label": "Appearance"
  },
  {
    "type": "checkbox",
    "property": "uc.zen-progress-bar.enabled",
    "label": "Enable progress bar",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "property": "uc.zen-progress-bar.style",
    "label": "Style",
    "defaultValue": "neon",
    "options": [
      { "label": "Neon (default)", "value": "neon" },
      { "label": "Windows XP", "value": "xp" },
      { "label": "Tahoe glass", "value": "tahoe" }
    ]
  },
  {
    "type": "dropdown",
    "property": "uc.zen-progress-bar.height",
    "label": "Bar height",
    "defaultValue": "2",
    "options": [
      { "label": "1px (hairline)", "value": "1" },
      { "label": "2px (default)", "value": "2" },
      { "label": "3px", "value": "3" },
      { "label": "4px", "value": "4" }
    ],
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } }
    ]
  },
  {
    "type": "dropdown",
    "property": "uc.zen-progress-bar.color-mode",
    "label": "Color mode",
    "defaultValue": "contrast",
    "options": [
      { "label": "Contrast vs page (default)", "value": "contrast" },
      { "label": "Zen accent", "value": "accent" },
      { "label": "Custom", "value": "custom" }
    ],
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } }
    ]
  },
  {
    "type": "string",
    "property": "uc.zen-progress-bar.color",
    "label": "Custom color (CSS)",
    "border": "value",
    "placeholder": "#7aa2f7",
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } },
      { "if": { "property": "uc.zen-progress-bar.color-mode", "value": "custom" } }
    ]
  },
  {
    "type": "checkbox",
    "property": "uc.zen-progress-bar.glow",
    "label": "Glow effect",
    "defaultValue": true,
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } }
    ]
  },
  {
    "type": "dropdown",
    "property": "uc.zen-progress-bar.glow-strength",
    "label": "Glow strength",
    "defaultValue": "medium",
    "options": [
      { "label": "Soft", "value": "soft" },
      { "label": "Medium (default)", "value": "medium" },
      { "label": "Strong", "value": "strong" }
    ],
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } },
      { "if": { "property": "uc.zen-progress-bar.glow", "value": true } }
    ]
  },
  {
    "type": "dropdown",
    "property": "uc.zen-progress-bar.position",
    "label": "Position",
    "defaultValue": "top",
    "options": [
      { "label": "Top", "value": "top" },
      { "label": "Bottom", "value": "bottom" }
    ]
  },
  {
    "type": "checkbox",
    "property": "uc.zen-progress-bar.rounded",
    "label": "Rounded leading edge",
    "defaultValue": true,
    "conditions": [
      { "if": { "property": "uc.zen-progress-bar.style", "value": "neon" } }
    ]
  }
]
